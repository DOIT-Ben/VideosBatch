# VideosBatch Skill CLI environment template
# Copy this file to a private .env file before use:
#   Copy-Item .\env.example .\.env
#   videosbatch --videosbatch-env .\.env doctor --json

# Optional remote adapter base URL. The default local folder workflow does not use it.
# Do not append /api here.
VIDEOSBATCH_BASE_URL=http://localhost:5173

# Optional access token for a protected deployment. Keep empty in local fake mode.
VIDEOSBATCH_ACCESS_TOKEN=

# Local Planner/Worker state. Use an absolute path when migrating machines.
VIDEOSBATCH_WORKER_HOME=

# Optional absolute path to specs/videosbatch-workflow-canonical.md.
# Required by `prompt build` when running outside the repository root.
VIDEOSBATCH_CANONICAL_SPEC=

# Safe local defaults. Real Provider/media actions require explicit runtime configuration and authorization.
VIDEOSBATCH_EXECUTOR_MODE=fake
VIDEOSBATCH_MEDIA_MODE=fake

# Direct local Provider defaults. These are the approved project routes; fill only
# the *_API_KEY values in a private copy unless a provider route is intentionally changed.
VIDEOSBATCH_LLM_PROVIDER=openai-responses
VIDEOSBATCH_LLM_BASE_URL=https://jingai.cc/v1
VIDEOSBATCH_LLM_MODEL=gpt-5.6-terra
VIDEOSBATCH_LLM_API_KEY=
VIDEOSBATCH_LLM_FALLBACK_BASE_URL=https://api.deepseek.com/
VIDEOSBATCH_LLM_FALLBACK_MODELS=deepseek-v4-flash
VIDEOSBATCH_LLM_FALLBACK_API_KEY=
VIDEOSBATCH_LLM_OUTPUT_MODE=json_schema
VIDEOSBATCH_LLM_FALLBACK_OUTPUT_MODE=json_schema
VIDEOSBATCH_LLM_MAX_RETRIES=3
VIDEOSBATCH_LLM_TIMEOUT_MS=180000

VIDEOSBATCH_IMAGE_PROVIDER=lyaiapp
VIDEOSBATCH_IMAGE_BASE_URL=https://api.lyaiapp.com/v1
VIDEOSBATCH_IMAGE_MODEL=gpt-image-2-1k
VIDEOSBATCH_IMAGE_SIZE=16:9
VIDEOSBATCH_IMAGE_API_KEY=

VIDEOSBATCH_VIDEO_PROVIDER=newapi-h3
VIDEOSBATCH_H3_BASE_URL=http://122.228.216.60/v1
VIDEOSBATCH_H3_ALLOW_HTTP=1
VIDEOSBATCH_H3_API_KEY=
VIDEOSBATCH_H3_POLL_MS=5000
VIDEOSBATCH_H3_TIMEOUT_MS=2700000

# Optional remote API routes (documented for migration; paths are fixed by the service contract):
# GET  ${VIDEOSBATCH_BASE_URL}/api/healthz
# GET  ${VIDEOSBATCH_BASE_URL}/api/readyz
# GET  ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch
# POST ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch/start
# POST ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch/run-next
# POST ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch/run-all
# PUT  ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch/stages/<stageId>/artifact
# POST ${VIDEOSBATCH_BASE_URL}/api/sessions/<sessionId>/videosbatch/retry/<stageId>
